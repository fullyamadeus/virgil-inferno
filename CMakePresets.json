{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "debug", "displayName": "Debug with tests", "generator": "Ninja",
      "binaryDir": "$env{HOME}/.cache/virgil-desktop/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON" }
    },
    {
      "name": "release", "inherits": "debug",
      "binaryDir": "$env{HOME}/.cache/virgil-desktop/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "OFF" }
    },
    {
      "name": "asan", "inherits": "debug",
      "binaryDir": "$env{HOME}/.cache/virgil-desktop/build/asan",
      "cacheVariables": { "VIRGIL_SANITIZERS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug", "jobs": 2 },
    { "name": "release", "configurePreset": "release", "jobs": 2 },
    { "name": "asan", "configurePreset": "asan", "jobs": 2 }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } }
  ]
}
